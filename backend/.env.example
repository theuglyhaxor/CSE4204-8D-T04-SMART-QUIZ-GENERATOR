# Copy this file to backend/.env and fill in your values.
# Everything here has a working default except the AI keys, so the backend runs
# out of the box with: python manage.py migrate && python manage.py runserver

# --- Django -------------------------------------------------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# --- Database -----------------------------------------------------------------
# sqlite (default) needs no setup at all — good for development and demos.
# Switch to mysql when you want the XAMPP / MariaDB deployment (database/schema.sql).
DB_ENGINE=sqlite
# DB_NAME=smart_quiz.sqlite3

# When DB_ENGINE=mysql:
# DB_ENGINE=mysql
# DB_NAME=smart_quiz_generator
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# --- CORS ---------------------------------------------------------------------
# The Vite dev server. Must match wherever the frontend is actually served from.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- AI providers -------------------------------------------------------------
# Which provider generate_quiz() uses by default: gemini | claude
# (A request may override it per call with a "provider" field.)
AI_PROVIDER=gemini

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT=30

# Anthropic Claude (only needed when using the claude provider)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-4-8
