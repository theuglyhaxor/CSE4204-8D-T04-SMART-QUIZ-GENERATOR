# Copy to frontend/.env only if you need to override the defaults.
# For normal local development you do NOT need this file at all.

# Where the app sends API calls.
# "/api" (default) goes through the Vite dev proxy -> no CORS in development.
# Set a full URL when the backend is deployed elsewhere, e.g.
#   VITE_API_BASE_URL=https://api.example.com/api
VITE_API_BASE_URL=/api

# Where the Vite dev proxy forwards "/api". Change if Django is not on :8000.
VITE_BACKEND_URL=http://127.0.0.1:8000
